<mujoco model="vr_arm">
  <option timestep="0.002" iterations="50" gravity="0 0 0"/>
  <visual>
    <global offwidth="1280" offheight="480"/>
    <quality offsamples="4"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
  </visual>
  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.5 0.7 0.9" rgb2="0.1 0.15 0.25" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.3 0.35" rgb2="0.15 0.18 0.22" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.1"/>
  </asset>

  <default>
    <joint armature="0.3" damping="20" limited="true"/>
    <position kp="3000" kv="50" forcerange="-500 500"/>
  </default>

  <worldbody>
    <light pos="2 2 4" dir="-0.5 -0.5 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="grid"/>

    <!-- Object the user can try to push around with the TCP. -->
    <body name="cube" pos="0.5 0.0 0.05">
      <freejoint/>
      <geom type="box" size="0.04 0.04 0.04" rgba="0.9 0.3 0.3 1" mass="0.1"/>
    </body>

    <!-- Live visualization of the VR target pose (green). -->
    <body name="vr_target_marker" mocap="true" pos="0.5 0 0.4">
      <geom type="sphere" size="0.02" rgba="0 1 0 0.6" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.005" rgba="1 0 0 0.8" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.05 0" size="0.005" rgba="0 1 0 0.8" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.05" size="0.005" rgba="0 0 1 0.8" contype="0" conaffinity="0"/>
    </body>

    <!-- 6-DOF arm. -->
    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.07 0.05" rgba="0.35 0.35 0.4 1"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="j1" axis="0 0 1" range="-3.0 3.0"/>
        <geom type="capsule" fromto="0 0 0  0 0 0.15" size="0.045" rgba="0.6 0.6 0.6 1"/>
        <body name="link2" pos="0 0 0.15">
          <joint name="j2" axis="0 1 0" range="-2.4 2.4"/>
          <geom type="capsule" fromto="0 0 0  0.22 0 0" size="0.04" rgba="0.6 0.6 0.6 1"/>
          <body name="link3" pos="0.22 0 0">
            <joint name="j3" axis="0 1 0" range="-2.6 2.6"/>
            <geom type="capsule" fromto="0 0 0  0.20 0 0" size="0.035" rgba="0.6 0.6 0.6 1"/>
            <body name="link4" pos="0.20 0 0">
              <joint name="j4" axis="1 0 0" range="-3.0 3.0"/>
              <geom type="capsule" fromto="0 0 0  0.06 0 0" size="0.028" rgba="0.55 0.55 0.55 1"/>
              <body name="link5" pos="0.06 0 0">
                <joint name="j5" axis="0 1 0" range="-2.0 2.0"/>
                <geom type="capsule" fromto="0 0 0  0.05 0 0" size="0.025" rgba="0.55 0.55 0.55 1"/>
                <body name="link6" pos="0.05 0 0">
                  <joint name="j6" axis="1 0 0" range="-3.0 3.0"/>
                  <geom type="box" pos="0.025 0 0" size="0.02 0.04 0.015" rgba="0.3 0.3 0.3 1"/>
                  <site name="tcp" pos="0.05 0 0" size="0.012" rgba="1 1 0 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- VR rig: head + L/R controllers. -->
    <body name="head" mocap="true" pos="0 -1.0 1.6">
      <geom type="sphere" size="0.04" rgba="1 1 1 0.25" contype="0" conaffinity="0"/>
      <camera name="left_eye"  pos="-0.032 0 0" fovy="90"/>
      <camera name="right_eye" pos=" 0.032 0 0" fovy="90"/>
    </body>
    <body name="controller_left" mocap="true" pos="-0.2 -0.8 1.2">
      <geom type="box" size="0.025 0.025 0.07" rgba="1.0 0.55 0.1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="controller_right" mocap="true" pos="0.2 -0.8 1.2">
      <geom type="box" size="0.025 0.025 0.07" rgba="0.2 0.7 1.0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <position name="a1" joint="j1"/>
    <position name="a2" joint="j2"/>
    <position name="a3" joint="j3"/>
    <position name="a4" joint="j4"/>
    <position name="a5" joint="j5"/>
    <position name="a6" joint="j6"/>
  </actuator>
</mujoco>
