<mujoco model="vr_scene">
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="480"/>
    <quality offsamples="4"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
  </visual>
  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.5 0.7 0.9" rgb2="0.1 0.15 0.25" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.3 0.35" rgb2="0.15 0.18 0.22" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="2 2 4" dir="-0.5 -0.5 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>

    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <!-- Some scene objects to look at -->
    <body name="box_red" pos="1.0 0.5 0.15">
      <freejoint/>
      <geom type="box" size="0.1 0.1 0.1" rgba="0.9 0.2 0.2 1"/>
    </body>
    <body name="box_green" pos="-1.0 0.7 0.15">
      <freejoint/>
      <geom type="box" size="0.1 0.1 0.1" rgba="0.2 0.8 0.2 1"/>
    </body>
    <body name="sphere_blue" pos="0.0 1.5 0.2">
      <freejoint/>
      <geom type="sphere" size="0.15" rgba="0.2 0.4 0.95 1"/>
    </body>
    <body name="pillar" pos="0 2.5 0.5">
      <geom type="cylinder" size="0.1 0.5" rgba="0.7 0.6 0.4 1"/>
    </body>

    <!-- Head mocap body holding two stereo cameras.
         WebXR pose is left-multiplied by the Y-up -> Z-up basis change before
         being written into mocap_pos / mocap_quat, so the body's local axes
         align with the standard camera convention (-Z forward, +Y up). -->
    <body name="head" mocap="true" pos="0 0 1.6">
      <geom type="sphere" size="0.04" rgba="1 1 1 0.25" contype="0" conaffinity="0"/>
      <camera name="left_eye"  pos="-0.032 0 0" fovy="90"/>
      <camera name="right_eye" pos=" 0.032 0 0" fovy="90"/>
    </body>

    <!-- Controllers as mocap bodies -->
    <body name="controller_left" mocap="true" pos="-0.2 0.2 1.2">
      <geom type="box" size="0.025 0.025 0.07" rgba="1.0 0.55 0.1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="controller_right" mocap="true" pos="0.2 0.2 1.2">
      <geom type="box" size="0.025 0.025 0.07" rgba="0.2 0.7 1.0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
